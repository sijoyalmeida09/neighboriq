# NeighborIQ — Environment Variables
# Copy to .env and fill in your keys

# Required for demographic data
# Get free key at: https://api.census.gov/data/key_signup.html
CENSUS_API_KEY=

# Optional: Yelp Fusion API (500 calls/day free)
# Get at: https://www.yelp.com/developers/v3/manage_app
YELP_API_KEY=

# Optional: LLM for deep market analysis (Groq is free tier)
# Get at: https://console.groq.com
GROQ_API_KEY=

# Optional: Anthropic Claude (fallback LLM)
ANTHROPIC_API_KEY=

# Optional: Telegram notifications
TELEGRAM_BOT_TOKEN=
TELEGRAM_SIJOY_CHAT_ID=
